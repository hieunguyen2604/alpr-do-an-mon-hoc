# =============================================================================
# ALPR -- environment template
# =============================================================================
# Copy this file to the PROJECT ROOT as `.env` (docker-compose.yml reads `.env`
# from the directory it sits in):
#
#     cp deployment/.env.example .env
#
# Every setting is optional: docker-compose.yml carries the same defaults
# inline, so the stack runs from a fresh clone with no .env at all. Uncomment
# only what you need to change.
#
# `.env` is excluded from both git and the Docker build context -- values are
# injected at run time and must never be baked into an image.
# =============================================================================

# --- Inference ---------------------------------------------------------------
# Read by ai.inference.InferenceConfig.from_env(). Paths are container paths.

#ALPR_MODEL_PATH=/app/models/best.pt

# CPU-only deployment (decision AD-06). Setting `cuda` here without also
# rebuilding the image against a CUDA torch build and enabling the NVIDIA
# Container Toolkit will fail at model-load time.
#ALPR_DEVICE=cpu
#ALPR_OCR_USE_GPU=false

# Detector confidence floor. Lower finds more plates and more false positives.
#ALPR_CONF_THRESHOLD=0.25

# NMS IoU threshold: how aggressively overlapping boxes are merged.
#ALPR_IOU_THRESHOLD=0.45

# Detector input size. Must be a positive multiple of 32 (YOLO requirement).
# 640 is the accuracy/latency compromise for the NFR-P1 budget on CPU.
#ALPR_IMGSZ=640

# Vietnamese plates use only Latin letters and digits, so the English model is
# both correct and faster than a multilingual one.
#ALPR_OCR_LANG=en

# Width/height ratio below which a crop is treated as a two-line plate.
#ALPR_TWO_LINE_ASPECT_RATIO=2.5

# --- Application -------------------------------------------------------------

# Four slashes = absolute path. Three would resolve relative to the working
# directory and put the database somewhere unintended.
#ALPR_DATABASE_URL=sqlite:////app/data/alpr.db

#ALPR_STORAGE_ROOT=/app/storage
#ALPR_LOG_LEVEL=info

# Explicit origins, never "*" (NFR-S4). Add the LAN origin for a remote demo,
# e.g. http://192.168.1.50:5173 -- the browser's address bar is what counts.
#ALPR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep at or below nginx's client_max_body_size (200m in nginx.conf), otherwise
# nginx rejects the upload first and the client gets its terse HTML 413 instead
# of the API's structured error.
#ALPR_MAX_UPLOAD_MB=200

# --- CPU thread budget -------------------------------------------------------
# The most influential performance knob on a GPU-less host. Rule of thumb:
# set to the number of PHYSICAL cores, and never above ALPR_CPU_LIMIT.
# Too high causes thread oversubscription between torch, Paddle and OpenBLAS,
# which typically makes inference slower while raising memory use.
#OMP_NUM_THREADS=4
#MKL_NUM_THREADS=4
#OPENBLAS_NUM_THREADS=4

# --- Host ports and paths ----------------------------------------------------

#ALPR_FRONTEND_PORT=5173

# Backend publishes to loopback only by default. Use 0.0.0.0 to expose the API
# directly on the LAN -- not needed for the UI, which is proxied through nginx.
#ALPR_BACKEND_BIND=127.0.0.1
#ALPR_BACKEND_PORT=8000

# Host directories bind-mounted into the backend.
#ALPR_STORAGE_HOST_DIR=./storage
#ALPR_MODELS_HOST_DIR=./models

# --- Resource limits ---------------------------------------------------------
#ALPR_CPU_LIMIT=4
#ALPR_MEMORY_LIMIT=4g

# --- Build-time --------------------------------------------------------------

# Keep torch on the CPU wheel index. Pointing this at default PyPI pulls the
# CUDA build plus bundled NVIDIA libraries: roughly +2.5 GB of image for
# hardware this deployment does not have.
#TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Pin a torch version if reproducibility matters; must exist on the index above.
#TORCH_VERSION=

# Vite inlines this at BUILD time. The relative default proxies through nginx
# and keeps the image host-agnostic; change it only if the API is served from a
# different origin, and update ALPR_CORS_ORIGINS to match.
#VITE_API_BASE_URL=/api

# On Linux, match these to `id -u` / `id -g` so the container can write to the
# bind-mounted ./storage directory.
#APP_UID=1000
#APP_GID=1000

# Image tag applied to both services.
#ALPR_TAG=latest
