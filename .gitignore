# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-ai/
.venv*/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Môi trường & bí mật ----------
.env
.env.*
!.env.example

# ---------- Cơ sở dữ liệu ----------
*.db
*.sqlite
*.sqlite3
backend/data/*.db
# SQLite write-ahead-log sidecar files (không khớp với *.db)
*.db-wal
*.db-shm
# ---------- Tệp người dùng tải lên khi chạy ----------
data/uploads/**
data/plates/**
data/outputs/**
!data/**/.gitkeep

# ---------- Dữ liệu & mô hình ----------
# Dataset thô quá lớn để đưa vào Git — dùng script tải về (Phase 2)
datasets/raw/**
datasets/processed/**
!datasets/**/.gitkeep
!datasets/**/README.md
# Thống kê dataset thì GIỮ LẠI — là sản phẩm bàn giao
!datasets/statistics/**

# Checkpoint trung gian bị loại, nhưng best.pt thì GIỮ LẠI (sản phẩm bàn giao)
models/**/*.pt
!models/best.pt
!models/*.onnx
runs/
wandb/

# ---------- Tệp do người dùng tải lên / hệ thống sinh ra ----------
backend/storage/
uploads/
outputs/
*.log
logs/

# ---------- Hệ điều hành ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------- IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# ---------- Tài liệu tạm ----------
docs/**/*.aux
docs/**/*.out
docs/**/~$*

# ---------- Bổ sung khi đóng gói (Phase 11) ----------
# Ảnh crop trung gian để gán nhãn — tái tạo bằng scripts/labeling/extract_plates.py.
# Giữ lại nhãn CSV (plate_labels.csv, plate_text_labels.csv) là sản phẩm thật.
datasets/annotations/plates_to_label/**
datasets/annotations/verify_samples/**
!datasets/annotations/*.csv

# Thư mục lưu trữ runtime ở gốc (ảnh do người dùng chạy thử sinh ra)
/storage/

# Bản COCO tải về đặt ở gốc khi huấn luyện — trùng md5 với models/pretrained/yolo11n-coco.pt
/yolo11n.pt

# Bản export ONNX/OpenVINO của baseline (epoch7) — tái tạo bằng ai/training/export.py.
# Giữ export của model chính thức: models/best.onnx.
models/checkpoints/exported/**
tools/
training-work/

# Sản phẩm sinh tự động của scripts/fill_chapter5.py — nó tạo lại tệp này mỗi
# lần chạy, nên theo dõi bản trong kho mã chỉ tạo ra 2,2 MB nhiễu diff mà không
# ai trích dẫn. Bộ số công bố nằm ở 05-results.json và 05-tables.md.
docs/reports/05-ocr-accuracy-adapted.json

# Bộ chuyển giao cho máy GPU — do scripts/make_gpu_transfer_kit.py dựng lại.
# 105 MB toàn bản chép của dữ liệu và trọng số đã có trong kho; theo dõi nó là
# lưu cùng một thứ hai lần.
/transfer-gpu-finetune/
/transfer-gpu-finetune*.zip

# Trọng số PP-OCRv5 gốc dùng làm điểm khởi đầu khi fine-tune — 68 MB, và là
# tệp công khai tải được, không phải sản phẩm của đồ án. Bỏ theo dõi 02/08/2026:
# một mình nó chiếm hơn một phần ba dung lượng kho mã.
#
# Cả ai/training/finetune_ppocr_rec.py lẫn notebook Colab đều TỰ TẢI khi thiếu:
#   https://paddleocr.bj.bcebos.com/PP-OCRv5/multilingual/
#       official_pretrained_model/en_PP-OCRv5_mobile_rec_pretrained.pdparams
models/pretrained/*.pdparams

# Bản nén của models/rec_finetuned/ — trùng từng byte với thư mục đã giải nén
# (977 / 7.578.229 / 214.461). Xoá 02/08/2026.
/rec_finetuned.zip

# Nguyên liệu gán nhãn ảnh toàn cảnh: 1.606 ảnh cắt + phiếu HTML, 49 MB, dựng
# lại bằng `scripts/dataset/build_scene_label_kit.py`. Thứ KHÔNG dựng lại được
# là nhãn do người gõ — nó là một tệp CSV đặt ở datasets/annotations/, nơi quy
# tắc `!datasets/annotations/*.csv` ở trên đã ép theo dõi.
datasets/annotations/scene_review/

# Hình lỗi của hai lượt đo phụ (28b — đối chứng nắn tỉ lệ trên 600 mẫu). Lượt
# này chỉ dùng để loại một giả thuyết trong lúc truy nguyên và không báo cáo
# nào trích; giữ payload JSON làm bằng chứng, bỏ 3 MB ảnh tái tạo được.
docs/reports/figures/28b-err/
docs/reports/figures/28b/

# Goi du lieu fine-tune de tai len Colab — dung lai bang
# `scripts/dataset/build_rec_finetune_set.py` roi nen thu muc
# datasets/processed/rec_finetune. 80 MB anh khong nen duoc, khong theo doi.
/rec_finetune.zip

# Tai lieu tham chieu cho Pandoc, sinh lai o moi lan chay build_thesis.py tu
# `pandoc --print-default-data-file reference.docx` roi va rieng kieu bang. La
# san pham trung gian thuan tuy, khong phai ban giao — xem
# `build_reference_docx` trong scripts/build_thesis.py.
# Khong dat tien to duong dan: moi thu muc chuong deu sinh mot ban rieng
# (docs/papers/ va docs/papers/mon-hoc/), va ban dau luat nay chi khop
# thu muc goc nen ban cua quyen mon hoc da lot vao mot commit.
reference-thesis.docx

# Thu muc ban nop: BAN SAO cua nhung tep vo da duoc theo doi o docs/papers/ va
# docs/slides/, dung lai o moi lan chay build_thesis.py hoac export_thesis_pdf.ps1.
# Theo doi chung se nhan doi 13 MB nhi phan trong lich su git moi lan dung lai,
# doi lay dung con so khong. Chi giu README de nguoi moi clone biet thu muc nay
# la gi va chay lenh nao de co no.
/nop/*
!/nop/README.md
