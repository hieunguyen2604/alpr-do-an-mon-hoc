# ---------------------------------------------------------------------------
# Environment configuration for the Vietnamese ALPR system.
#
# Copy this file to `.env` at the PROJECT ROOT (d:/DATN/.env) and edit it.
# `.env` is git-ignored; this example file is committed.
#
#     cp backend/.env.example .env
#
# Every variable is OPTIONAL: each one falls back to the default shown here,
# so the system starts with no `.env` file at all. Leaving a variable empty
# (`ALPR_DEVICE=`) is treated as "not set", not as an empty string.
#
# One file, two consumers. The `ALPR_` prefix is shared by:
#   * backend/core/config.py    -> Settings          (pydantic-settings)
#   * ai/inference/config.py    -> InferenceConfig   (plain dataclass)
# The `ai` package cannot use pydantic (NFR-M1), so the two configuration
# objects are different types that read the same variables. The inference
# settings at the bottom of this file are consumed by BOTH -- set them once.
#
# Relative paths are resolved against the PROJECT ROOT, never against the
# current working directory, so the server and Alembic agree on every location
# regardless of the folder they were started from (NFR-M4).
# ---------------------------------------------------------------------------


# --- Application -----------------------------------------------------------

# Service name shown in the Swagger page title and the /health response.
ALPR_APP_NAME=Vietnamese ALPR API

# Version string reported by /health.
ALPR_APP_VERSION=0.1.0

# Verbose server-side diagnostics: SQL statement echo and full tracebacks in
# the log. This does NOT change what a user sees -- error responses stay free
# of technical detail either way (NFR-S4). Keep false in deployment: SQL echo
# is slow and noisy.
ALPR_DEBUG=false

# Path prefix mounted in front of every router, e.g. /api/detect/image.
ALPR_API_PREFIX=/api


# --- Database --------------------------------------------------------------

# SQLAlchemy connection URL. A relative SQLite path is rewritten to an absolute
# one under the project root at start-up; without that, launching uvicorn from
# backend/ and Alembic from the repository root would open two different files
# and the data would appear to vanish.
ALPR_DATABASE_URL=sqlite:///./data/alpr.db


# --- Storage ---------------------------------------------------------------

# Base directory for everything written to disk. Relative to the project root.
ALPR_STORAGE_ROOT=data

# Sub-directories. A relative value is resolved against ALPR_STORAGE_ROOT;
# an absolute value is used as given -- useful for putting uploads on a
# separate volume in Docker.
ALPR_UPLOAD_DIR=uploads    # original uploaded images and videos
ALPR_PLATE_DIR=plates      # cropped license plate images
ALPR_OUTPUT_DIR=outputs    # annotated images and processed videos


# --- Upload limits (NFR-S3) ------------------------------------------------

# Enforced server-side. The frontend checks these too, but that check is a
# convenience: a request arriving over HTTP may not have gone through it.
# Exceeding a limit returns HTTP 413.
ALPR_MAX_IMAGE_SIZE_MB=10
ALPR_MAX_VIDEO_SIZE_MB=200

# Accepted MIME types, comma-separated. Verified against the file's magic
# bytes, never its extension (NFR-S1), so renaming archive.zip to photo.jpg
# does not get it past this list.
ALPR_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/bmp
ALPR_ALLOWED_VIDEO_TYPES=video/mp4,video/x-msvideo,video/quicktime,video/x-matroska


# --- Security --------------------------------------------------------------

# Browser origins allowed to call the API, comma-separated.
#
# `*` IS REJECTED AT START-UP and the process will refuse to boot (NFR-S4).
# That is deliberate: `*` is exactly the value someone sets while debugging a
# CORS problem and then forgets to remove. List the real origins instead.
# 5173 is the Vite development server's default port.
ALPR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Inference (read by BOTH backend and the ai package) -------------------

# Trained YOLO detector weights. Relative to the project root.
# Produced in Phase 3; until then the file does not exist and /health reports
# "degraded".
ALPR_MODEL_PATH=models/best.pt

# Torch device. Defaults to cpu -- the target machine has no CUDA GPU
# (decision AD-06). Training happens on Colab/Kaggle, inference here on CPU.
ALPR_DEVICE=cpu

# Minimum detector confidence for a box to be kept, 0.0 to 1.0.
# Lower finds more plates and more false positives.
ALPR_CONF_THRESHOLD=0.25

# IoU threshold for non-maximum suppression, 0.0 to 1.0. Controls how
# aggressively overlapping boxes for the same plate are merged.
ALPR_IOU_THRESHOLD=0.45

# Square detector input size in pixels. MUST be a multiple of 32: the YOLO
# backbone downsamples by 32, and any other value is silently resized, meaning
# the configured number would not be the one actually used. Rejected at
# start-up.
ALPR_IMGSZ=640

# Process every Nth video frame. Raising this speeds video jobs up roughly
# proportionally, at the risk of missing a plate that is only briefly visible.
# 5 is a starting point; Phase 7 measures it against NFR-P3.
ALPR_FRAME_STRIDE=5

# OCR language. Vietnamese plates carry only Latin letters and digits, so the
# English model is both correct and faster than a multilingual one.
# Read by the ai package only.
ALPR_OCR_LANG=en

# Whether the OCR engine may use a GPU. Read by the ai package only.
ALPR_OCR_USE_GPU=false

# Width/height ratio below which a plate crop is treated as two-line.
# Vietnamese single-line plates are much wider than tall; two-line plates are
# nearly square. Read by the ai package only.
ALPR_TWO_LINE_ASPECT_RATIO=2.5


# --- Logging ---------------------------------------------------------------

# Root log level: CRITICAL, ERROR, WARNING, INFO, DEBUG.
# Logs are emitted as one JSON object per line on stdout, each carrying a
# request_id, so a single request can be reconstructed from interleaved output:
#     jq 'select(.request_id == "8c1d...")' backend.log
ALPR_LOG_LEVEL=INFO
