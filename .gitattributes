# Chuẩn hoá ký tự xuống dòng — dự án phát triển trên Windows,
# triển khai trên Linux (Docker). Xem docs/00-requirements/environment.md muc 3.4.
* text=auto eol=lf

# Script Windows bắt buộc giữ CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Tệp nhị phân — không đụng vào
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bmp   binary
*.mp4   binary
*.avi   binary
*.mov   binary
*.pt    binary
*.onnx  binary
*.pdf   binary
*.pptx  binary
*.db    binary
