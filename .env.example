# =============================================================================
# Mẫu biến môi trường — COPY file này thành `.env` rồi điền giá trị thật
# =============================================================================
#   cp .env.example .env
#
# `.env` đã được .gitignore (dòng 31) nên KHÔNG bao giờ bị commit lên Git.
# `.env.example` thì ĐƯỢC commit — nó chỉ chứa tên biến, không chứa giá trị.
#
# Script tải dữ liệu tự động che credential trong log, nên key sẽ không
# rò rỉ ra file log dù có bật --verbose.
# =============================================================================

# --- Roboflow ----------------------------------------------------------------
# Lấy tại: https://app.roboflow.com/settings/api  (mục "Private API Key")
# Tài khoản miễn phí là đủ.
ROBOFLOW_API_KEY=

# --- Kaggle (tuỳ chọn, chưa cần lúc này) -------------------------------------
# Lấy tại: https://www.kaggle.com/settings -> "Create New Token" -> kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- HuggingFace (tuỳ chọn) --------------------------------------------------
# Chỉ cần khi tải bộ dữ liệu gated/private. Bộ đang dùng là public nên không cần.
HF_TOKEN=

# =============================================================================
# Cấu hình ứng dụng (backend đọc các biến này)
# =============================================================================
ALPR_DATABASE_URL=sqlite:///./data/alpr.db
# --- Bộ phát hiện biển số ---
# MẶC ĐỊNH: mô hình chính thức của đồ án (YOLO11n, imgsz=640, split v3, 20 epoch).
# Tệp này CÓ trong repo nên clone về là chạy được ngay, không cần bước nào thêm.
#   mAP@0.5 = 0,9829 · mAP@0.5:0.95 = 0,7834 · P = 0,9837 · R = 0,9714
ALPR_MODEL_PATH=models/best.pt
#
# TUỲ CHỌN TĂNG TỐC — OpenVINO nhanh hơn PyTorch trên CPU Intel.
# Phase 7 đo trên i5-14600K (14 nhân vật lý / 20 nhân logic, CPU thuần):
# OpenVINO 16,6 ms so với PyTorch 27,7 ms ở p50 (nhanh hơn 1,66x); khi chạy
# chung tiến trình với PaddleOCR khoảng cách còn giãn ra (20,9 ms so với 98,7 ms)
# vì PyTorch tranh luồng với Paddle.
#
# Bản OpenVINO KHÔNG được commit (dung lượng lớn, tái tạo được) — muốn dùng thì
# tự xuất từ mô hình chính thức rồi đổi ALPR_MODEL_PATH sang thư mục sinh ra:
#   python -m ai.training.export --weights models/best.pt --format openvino --imgsz 640
# Lưu ý: khi đó giá trị là ĐƯỜNG DẪN THƯ MỤC, không phải tệp .pt.
ALPR_DEVICE=cpu
ALPR_CONF_THRESHOLD=0.25
ALPR_IOU_THRESHOLD=0.45
# Giữ nguyên 640. Giảm xuống 480/416 CHỈ tiết kiệm ~6 ms ở bước phát hiện —
# không đáng để đánh đổi mAP, vì nút thắt nằm ở OCR chứ không ở bộ phát hiện.
ALPR_IMGSZ=640
ALPR_CORS_ORIGINS=http://localhost:5173
ALPR_LOG_LEVEL=INFO
